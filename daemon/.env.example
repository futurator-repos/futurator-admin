# AWS region — must match where sst deployed the tables
AWS_REGION=us-east-1

# Table names — copy from `sst deploy` output or from the AWS console.
# With explicit names these should be:
AGENT_JOBS_TABLE=futurator-agent-jobs
AGENT_EVENTS_TABLE=futurator-agent-events

# Polling interval in ms (default 3000)
POLL_INTERVAL_MS=3000
