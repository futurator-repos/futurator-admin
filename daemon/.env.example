# AWS region — must match where sst deployed the tables
AWS_REGION=us-east-1

# Table names — copy from `sst deploy` output or from the AWS console.
# With explicit names these should be:
AGENT_JOBS_TABLE=futurator-agent-jobs
AGENT_EVENTS_TABLE=futurator-agent-events

# Polling interval in ms (default 3000)
POLL_INTERVAL_MS=3000

# Claude Code CLI max output tokens. The CLI defaults to 32000; the pm-plan
# (epics→waves) agent for a complex spec can exceed that and overflow mid-JSON,
# so the closing ---END_PLAN_JSON--- fence is never written and NOTHING is
# captured (the pacmanv3 32:32 / no-PLAN_JSON failure, 2026-06-20). 64000 gives
# headroom; the pm-plan prompt's output-budget contract keeps plans compact so
# this is a safety ceiling, not a target. Inherited by every spawned `claude`.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000
