    "agent:pause": "node scripts/agent-flag.mjs pause",
    "agent:resume": "node scripts/agent-flag.mjs resume",
    "agent:status": "node scripts/agent-flag.mjs status",
    "ci": "npm run lint && npm run format:check && npm run knip && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
