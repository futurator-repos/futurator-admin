# .env.local.example — Futurator-Admin local development environment
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Production values are managed by SST (SSM Parameter Store / Secrets Manager).
# You only need this file when running `npm run dev` without an SST environment.

# ── GitHub Personal Access Token ─────────────────────────────────────────────
# Required for Pipeline v2 GitHub integration (Story 1.1.2+).
#
# LOCAL DEV ONLY — production reads this from SSM via the SST-linked secret:
#   `sst secret set GithubPat <value>`              (production stage)
#   `sst secret set GithubPat <value> --stage dev`  (dev stage)
#
# Create a fine-grained PAT at https://github.com/settings/personal-access-tokens/new
# Minimum scopes: Contents (read+write), Pull requests (read+write), Metadata (read).
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── API URL (Next.js public env) ──────────────────────────────────────────────
# Point to a deployed Lambda URL when testing frontend against a remote API.
# Leave unset to use relative /api/* paths (default for local dev with `npm run dev`).
# NEXT_PUBLIC_API_URL=https://<your-lambda-url>.lambda-url.us-east-1.on.aws
