  <story>
    <asA>developer</asA>
    <iWant>a compilation step triggered after any document generation session in pre-dev phases</iWant>
    <soThat>PRDs, architecture specs, and planning documents are automatically decomposed into knowledge nodes</soThat>
    <tasks>
      <task id="1" ac="2">Define agent-to-article-type mapping
        <subtask>Create mapping configuration: PM to prd/requirement/epic-plan/story-plan; Analyst to brief/research/competitive-analysis; Architect to architecture/tech-spec/api-spec/data-model/adr; UX to ux-spec</subtask>
        <subtask>Map each article type to its phase directory: discovery/ for brainstorm/brief/research, planning/ for prd/requirement/epic-plan/story-plan, solutioning/ for architecture/tech-spec/api-spec/data-model/adr/ux-spec</subtask>
        <subtask>Add mapping to a shared config module at /home/ubuntu/scripts/lib/article-types.mjs</subtask>
      </task>
      <task id="2" ac="1,2,3">Create pre-dev compilation step logic
        <subtask>Create /home/ubuntu/scripts/compile-predev.mjs as the pre-dev compilation entry point</subtask>
        <subtask>Accept arguments: --project, --document-path, --agent-type, --session-id</subtask>
        <subtask>Parse the generated document to extract frontmatter fields (title, type, phase, status, tags)</subtask>
        <subtask>Create or update the wiki article in knowledge/{phase}/{slug}.md using the standard article format</subtask>
        <subtask>Scan the document for cross-references and generate [[wikilinks]] in Dependencies, Derived From, Informs sections</subtask>
      </task>
      <task id="3" ac="4">Integrate maturity assessment
        <subtask>Implement maturity scoring logic per architecture doc section 6.3 (purpose defined, dependencies listed, acceptance criteria present, etc.)</subtask>
        <subtask>Map assessment to 0.0-1.0 scale: Raw (0.0-0.2), Early (0.2-0.4), Partial (0.4-0.6), Solid (0.6-0.8), Ready (0.8-1.0)</subtask>
        <subtask>Store maturity score in article frontmatter maturity field</subtask>
      </task>
      <task id="4" ac="5,6">Wire embed + sync + impact propagation
        <subtask>After article creation/update, call graph-sync.mjs --project {projectId} --knowledge-dir {workingDir}/knowledge to embed and upsert to Memgraph</subtask>
        <subtask>After sync, run impact propagation (Story 3.5) traversing graph from updated node following outgoing edges up to 4 hops, flag downstream nodes per weight/hop formula</subtask>
        <subtask>Update flagged article frontmatter with status: flagged and flagReason referencing the changed upstream node</subtask>
      </task>
      <task id="5" ac="1,7">Integrate into existing document generation pipelines
        <subtask>Extend generateDocumentPipeline() to append a COMPILE step after the document generation agent step completes</subtask>
        <subtask>The COMPILE step sequence: shell (extract document path) then agent (compile to wiki article) then shell (embed + sync + impact propagation)</subtask>
        <subtask>Log compilation record to knowledge/log.md: timestamp, session-id, agent-type, article-type, nodeId, maturity score</subtask>
        <subtask>Update knowledge/index.md with new/updated article entry</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">When a PM, Analyst, Architect, or UX agent session generates or revises a document, a COMPILE step runs automatically after the document generation pipeline completes</criterion>
    <criterion id="2">The compilation creates/updates wiki articles for the generated document, stored as a typed article (prd, architecture, tech-spec, ux-spec, brainstorm, brief, research, etc.) in the appropriate phase directory under knowledge/</criterion>
    <criterion id="3">[[wikilinks]] are generated linking the new article to related existing nodes (requirements, decisions, code articles, discovery nodes)</criterion>
    <criterion id="4">Maturity score (0.0-1.0) is assessed based on content completeness and stored in the article frontmatter</criterion>
    <criterion id="5">The article is embedded via Voyage AI and synced to Memgraph via graph-sync.mjs</criterion>
    <criterion id="6">Impact propagation runs after sync — if the document revises an existing node, downstream nodes are flagged for review per Story 3.5 rules (score >= 0.5 critical, score >= 0.1 moderate)</criterion>
    <criterion id="7">Compilation results are logged in knowledge/log.md with timestamp, article type, nodeId, and maturity score</criterion>
  </acceptanceCriteria>

