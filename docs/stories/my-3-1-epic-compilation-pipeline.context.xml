  <story>
    <asA>developer</asA>
    <iWant>a compilation pipeline triggered when an epic transitions to completed status</iWant>
    <soThat>cross-story knowledge is synthesized, superseded nodes are detected, and maturity scores are updated</soThat>
    <tasks>
      <task id="1" ac="1">Create epic status transition listener
        <subtask>Hook into the epic workflow status state machine to detect completed transitions</subtask>
        <subtask>Create generateEpicCompilePipeline() function that builds the two-step pipeline definition</subtask>
        <subtask>Enqueue the epic-compile job to futurator-agent-jobs with epicId, projectId, and EPIC_TITLE context</subtask>
        <subtask>Emit pipeline status events for each compilation sub-step to futurator-agent-events</subtask>
      </task>
      <task id="2" ac="2,3,4,5,6">Implement COMPILER agent consolidation step
        <subtask>Create the agent step definition with agentId: COMPILER and prompt from architecture doc section 4.3</subtask>
        <subtask>Inject EPIC_TITLE, STORY_COUNT, and INDEX_CONTENT (from knowledge/index.md) into the agent prompt</subtask>
        <subtask>Agent reads all knowledge/code/ articles filtered by createdByEpic or lastMutatedByStory matching this epic's stories</subtask>
        <subtask>Agent writes knowledge/planning/epic-{epicId}-synthesis.md with cross-story synthesis</subtask>
        <subtask>Agent runs supersession scan — marks older as status: superseded and adds [[supersedes]] links</subtask>
        <subtask>Agent reassesses maturity scores for related requirement/decision nodes based on implementation outcomes</subtask>
        <subtask>Agent runs lint pass — checks for contradictions, orphan nodes, stale [[wikilinks]]</subtask>
        <subtask>Agent updates knowledge/system/pending-work.md with incomplete items</subtask>
        <subtask>Agent updates knowledge/index.md and appends compilation record to knowledge/log.md</subtask>
      </task>
      <task id="3" ac="7">Implement full graph resync shell step
        <subtask>Add shell step calling node /home/ubuntu/scripts/graph-sync.mjs --project {{projectId}} --full-resync --knowledge-dir {{workingDir}}/knowledge --state-file {{workingDir}}/.mycelium/compile-state.json</subtask>
        <subtask>Full resync re-embeds all articles regardless of content hash, capturing maturity/status/supersession changes</subtask>
        <subtask>Include S3 backup of knowledge/ directory after sync</subtask>
      </task>
      <task id="4" ac="5,8">Implement lint output formatting
        <subtask>Define lint output format: [WARN] for non-critical, [CRITICAL] for contradictions and broken references</subtask>
        <subtask>Warnings appended to knowledge/log.md with timestamp and epic context</subtask>
        <subtask>Critical issues written to knowledge/system/pending-work.md with severity and remediation hints</subtask>
      </task>
      <task id="5" ac="1">Error handling and non-blocking behavior
        <subtask>Epic compilation failure does NOT revert the epic's completed status</subtask>
        <subtask>Compilation errors are logged in futurator-agent-events with full stack traces</subtask>
        <subtask>Add compilationStatus: success | failed | skipped to epic workflow record</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">When an epic's status transitions to completed in the workflow, an epic-compile pipeline job is automatically created and enqueued</criterion>
    <criterion id="2">A COMPILER agent reads all code articles created/modified by this epic's stories and creates a cross-story synthesis article at knowledge/planning/epic-{epicId}-synthesis.md</criterion>
    <criterion id="3">The COMPILER performs a supersession scan: finds articles where a later story overwrote an earlier story's work, marks older versions as status: superseded, and adds [[supersedes]] links</criterion>
    <criterion id="4">Maturity scores are updated for all requirement/decision nodes related to this epic based on what was actually implemented</criterion>
    <criterion id="5">A lint pass detects contradictions between articles, orphan nodes with no edges, and stale cross-references to renamed/deleted files</criterion>
    <criterion id="6">knowledge/system/pending-work.md is updated with remaining incomplete items from this epic</criterion>
    <criterion id="7">A full Memgraph resync (--full-resync) runs after the agent step completes</criterion>
    <criterion id="8">Lint warnings are written to knowledge/log.md; critical issues are added to knowledge/system/pending-work.md</criterion>
  </acceptanceCriteria>

