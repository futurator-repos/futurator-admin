  <story>
    <asA>developer</asA>
    <iWant>compilation status tracked per story and surfaced in the pipeline events</iWant>
    <soThat>I can monitor compilation health and debug failures without affecting story delivery</soThat>
    <tasks>
      <task id="1" ac="1">Extend workflow types with compilation metadata
        <subtask>Add compilationStatus?: 'success' | 'failed' | 'skipped' to EpicStory in functions/shared/types/epic-workflow.ts</subtask>
        <subtask>Add compilationStartedAt?: string and compilationCompletedAt?: string timestamps to EpicStory</subtask>
        <subtask>Add compilationArticleCounts?: { created: number; updated: number; superseded: number } to EpicStory</subtask>
        <subtask>Mirror all type additions in src/types/epic-workflow.ts for frontend consumption</subtask>
      </task>
      <task id="2" ac="2">Implement compilation timing capture
        <subtask>Record compilationStartedAt when the compile-diff step begins</subtask>
        <subtask>Record compilationCompletedAt when the compile-sync step completes (or when any compile step fails)</subtask>
        <subtask>Calculate duration and include in the completion event payload</subtask>
        <subtask>Extract article counts from the COMPILER agent output and/or graph-sync.mjs stdout</subtask>
      </task>
      <task id="3" ac="2,3">Emit structured compilation events
        <subtask>Emit a compilation-started event to futurator-agent-events when the COMPILE phase begins</subtask>
        <subtask>Emit a compilation-completed event with status, timing, and article counts on success</subtask>
        <subtask>Emit a compilation-failed event with error message and stack trace on failure</subtask>
        <subtask>Ensure events include storyId, epicId, and projectId for correlation</subtask>
      </task>
      <task id="4" ac="4">Implement non-blocking error handling
        <subtask>Wrap the COMPILE phase execution in a try/catch in the pipeline orchestrator</subtask>
        <subtask>On catch: set compilationStatus: 'failed', emit warning event, but allow story to proceed to done status</subtask>
        <subtask>Set compilationStatus: 'skipped' when the COMPILE phase is skipped (e.g., no diff, or Epic 1 infra not yet deployed)</subtask>
        <subtask>Set compilationStatus: 'success' only when all three compile sub-steps complete without error</subtask>
      </task>
      <task id="5" ac="5">Update knowledge log with compilation results
        <subtask>On successful compilation: append a success record to knowledge/log.md (already handled by COMPILER agent in Story 2.3, verify it works)</subtask>
        <subtask>On failed compilation: append a failure record to knowledge/log.md with error summary — this requires a fallback write since the COMPILER agent may have been the step that failed</subtask>
        <subtask>Define a consistent log entry format: | {timestamp} | {storyId} | {status} | {articles_created}/{articles_updated}/{articles_superseded} | {error_summary} |</subtask>
      </task>
      <task id="6" ac="1">Persist compilation status to DynamoDB
        <subtask>Update the EpicWorkflow repository to persist compilationStatus and metadata when updating story status</subtask>
        <subtask>Ensure the existing updateStoryStatus() or equivalent function handles the new fields</subtask>
        <subtask>Verify the frontend can read and display compilationStatus from the API response</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">The story's workflow record includes compilationStatus: 'success' | 'failed' | 'skipped' reflecting the outcome of the COMPILE phase</criterion>
    <criterion id="2">Compilation timing (start time, end time, duration) and article counts (created, updated, superseded) are recorded in pipeline events</criterion>
    <criterion id="3">Compilation errors are logged with full stack traces in agent events emitted to futurator-agent-events</criterion>
    <criterion id="4">A failed compilation emits a warning event but the story is still marked as completed (non-blocking)</criterion>
    <criterion id="5">knowledge/log.md records both successful and failed compilation attempts with timestamps and error summaries</criterion>
  </acceptanceCriteria>

