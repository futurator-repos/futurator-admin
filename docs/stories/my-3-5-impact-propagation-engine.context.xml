    <criterion id="3">Nodes with impact score >= 0.5 are flagged as critical with status: flagged and flagSeverity: critical</criterion>
    <criterion id="4">Nodes with impact score >= 0.1 are flagged as moderate with status: flagged and flagSeverity: moderate</criterion>
