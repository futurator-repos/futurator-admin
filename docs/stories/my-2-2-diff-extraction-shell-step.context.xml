  <story>
    <asA>developer</asA>
    <iWant>a shell step that extracts the list of changed files after a story completes</iWant>
    <soThat>the Knowledge Compiler knows exactly which files to process</soThat>
    <tasks>
      <task id="1" ac="1,2,6">Implement the diff extraction shell command
        <subtask>Define the compile-diff shell step in generateStoryPipeline() with the git diff command</subtask>
        <subtask>Set captureAs: 'DIFF_MANIFEST' so the output is available to the next step</subtask>
        <subtask>Ensure the command runs in the project's workingDir via cd ${workingDir}</subtask>
        <subtask>Validate output format matches STATUS\tFILENAME for each changed file</subtask>
      </task>
      <task id="2" ac="3,4">Implement the fallback detection mechanism
        <subtask>Add 2>/dev/null || fallback to find command when git diff fails</subtask>
        <subtask>Configure find with -not -path exclusions for node_modules/, .git/, and knowledge/</subtask>
        <subtask>Ensure the find fallback produces compatible output format (map found files to A\tFILENAME)</subtask>
      </task>
      <task id="3" ac="5">Handle the compile marker file
        <subtask>Create .mycelium/last-compile-marker if it does not exist (first compilation)</subtask>
        <subtask>After successful diff extraction, update the marker with touch .mycelium/last-compile-marker</subtask>
        <subtask>Ensure the marker update is appended to the shell command so it only runs on success</subtask>
      </task>
      <task id="4" ac="4">Add directory exclusion filters
        <subtask>For git diff mode: pipe through grep -v to exclude node_modules/, .git/, knowledge/</subtask>
        <subtask>For find fallback mode: use -not -path arguments for each excluded directory</subtask>
        <subtask>Verify exclusions work for nested paths (e.g., src/node_modules/ should still be excluded)</subtask>
      </task>
      <task id="5" ac="1,2,3">Test edge cases
        <subtask>Verify behavior when no files have changed (empty DIFF_MANIFEST)</subtask>
        <subtask>Verify behavior on first-ever compilation (no git history, no marker file)</subtask>
        <subtask>Verify behavior when git repository has uncommitted changes</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">The diff extraction step outputs a DIFF_MANIFEST listing all created, modified, and deleted files</criterion>
    <criterion id="2">When git history is available, the step uses git diff --name-status HEAD~1 HEAD to determine changes</criterion>
    <criterion id="3">When git is not available, the step falls back to find . -newer .mycelium/last-compile-marker -type f to detect changes by timestamp</criterion>
    <criterion id="4">The output excludes node_modules/, .git/, and knowledge/ directories</criterion>
    <criterion id="5">The step updates .mycelium/last-compile-marker timestamp after successful extraction</criterion>
    <criterion id="6">The output format is one line per file: STATUS\tFILENAME (A=added, M=modified, D=deleted)</criterion>
  </acceptanceCriteria>

