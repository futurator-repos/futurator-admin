  <constraints>
    <constraint type="regeneration">System articles are FULLY regenerated on each epic compilation (AC #6). They are not incrementally updated. The COMPILER agent rewrites them from scratch based on current graph state.</constraint>
    <constraint type="incremental">EXCEPTION: dependency-map.md is updated incrementally during story compilation (AC #7). Only new DEPENDS_ON edges are appended, not the full file rewritten.</constraint>
    <constraint type="dependency">This story depends on Epic 2 (story compilation must be working) and Story 3.1 (epic compilation pipeline must exist for the full regeneration trigger).</constraint>
    <constraint type="maturity">System articles always have maturity: 1.0 because they are always current by definition (regenerated from live data). They should never appear in pending-work.md themselves.</constraint>
    <constraint type="architecture">Wiki files are the source of truth. System articles are generated files that live on EC2 within each project's knowledge/system/ directory and are backed up to S3.</constraint>
    <constraint type="wikilinks">System articles MUST use [[wikilinks]] to reference the nodes they catalog. This ensures edges are created in Memgraph during graph-sync, connecting system articles to the nodes they describe.</constraint>
  </constraints>

  <interfaces>
    <interface>
      <name>System article frontmatter</name>
      <kind>data format</kind>
      <signature>type: system, phase: system, status: active, maturity: 1.0, created: {date}, updated: {date}</signature>
      <path>knowledge/system/*.md</path>
    </interface>
    <interface>
      <name>Pending work query</name>
      <kind>Cypher query</kind>
      <signature>MATCH (n:Node) WHERE n.projectId = $projectId AND n.status IN ['active', 'flagged'] AND n.maturity &lt; 0.6 RETURN n.nodeId, n.type, n.phase, n.title, n.maturity, n.status ORDER BY phase priority, maturity ASC</signature>
      <path>Memgraph / knowledge/index.md</path>
    </interface>
    <interface>
      <name>COMPILER agent prompt extension</name>
      <kind>prompt integration</kind>
      <signature>Additional tasks added to COMPILER prompt for system article generation (epic compilation: full regen, story compilation: incremental dependency-map only)</signature>
      <path>Pipeline definition in generateEpicCompilePipeline() and generateStoryPipeline()</path>
    </interface>
  </interfaces>

