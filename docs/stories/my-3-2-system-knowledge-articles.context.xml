  <story>
    <asA>developer</asA>
    <iWant>system-level knowledge articles automatically maintained by the compilation pipeline</iWant>
    <soThat>cross-cutting concerns (pending work, deployment state, tech debt) are always visible as a project dashboard</soThat>
    <tasks>
      <task id="1" ac="5">Define system article frontmatter and format
        <subtask>Create standard frontmatter template for system articles: type: system, phase: system, status: active, maturity: 1.0</subtask>
        <subtask>Define section structure for each of the four system articles</subtask>
        <subtask>Ensure system articles use [[wikilinks]] to reference the nodes they catalog</subtask>
      </task>
      <task id="2" ac="1,6">Implement pending-work.md generation
        <subtask>Query all nodes from knowledge/index.md (or Memgraph) with maturity less than 0.6 or status: flagged</subtask>
        <subtask>Group results by phase with counts and summaries</subtask>
        <subtask>For flagged nodes, include flagReason and flagSeverity</subtask>
        <subtask>Sort within each phase by maturity ascending (most incomplete first)</subtask>
        <subtask>Integrate into epic compilation agent prompt (COMPILER generates this article)</subtask>
      </task>
      <task id="3" ac="2,6,7">Implement dependency-map.md generation
        <subtask>Full regeneration mode (epic compilation): traverse all DEPENDS_ON edges, render as hierarchical list</subtask>
        <subtask>Incremental mode (story compilation): append new DEPENDS_ON edges without rewriting the entire file</subtask>
        <subtask>Include dependency direction and edge count per node</subtask>
        <subtask>Flag circular dependencies if detected</subtask>
      </task>
      <task id="4" ac="3,6">Implement debt-registry.md generation
        <subtask>Scan all articles for Missing Signals sections — each missing signal is a potential debt item</subtask>
        <subtask>Scan for explicit tech debt markers (TODO, HACK, WORKAROUND, tech debt)</subtask>
        <subtask>Assign severity based on article maturity and gap nature</subtask>
        <subtask>Record origin story from article frontmatter for traceability</subtask>
        <subtask>Group by severity then by phase</subtask>
      </task>
      <task id="5" ac="4,6">Implement deployment-manifest.md generation
        <subtask>List all code articles with status: deployed — include deploy date, epic, and deploy URL</subtask>
        <subtask>List all code articles with status: active not yet deployed — pending deployment</subtask>
        <subtask>Include summary counts: deployed vs. pending vs. superseded</subtask>
        <subtask>Link to latest knowledge/release/deploy-{date}.md record</subtask>
      </task>
      <task id="6" ac="6,7">Integrate system article generation into compilation pipeline
        <subtask>Add system article regeneration as a task in epic compilation COMPILER agent prompt (Story 3.1)</subtask>
        <subtask>Add incremental dependency-map.md update as a task in story compilation COMPILER agent prompt (Epic 2)</subtask>
        <subtask>Ensure knowledge/index.md includes entries for all four system articles</subtask>
        <subtask>System articles are synced to Memgraph as nodes with type: system during graph-sync</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">knowledge/system/pending-work.md lists all nodes with maturity less than 0.6 or status flagged, grouped by phase (discovery, planning, solutioning, implementation, qa, release, support)</criterion>
    <criterion id="2">knowledge/system/dependency-map.md shows the top-level import graph across all code articles, derived from DEPENDS_ON edges</criterion>
    <criterion id="3">knowledge/system/debt-registry.md lists items flagged as tech debt with severity (critical, moderate, low), origin story, and description</criterion>
    <criterion id="4">knowledge/system/deployment-manifest.md tracks which code articles are deployed vs. pending deployment, with last deploy date and deploy URL</criterion>
    <criterion id="5">Each system article has valid frontmatter with type: system and phase: system</criterion>
    <criterion id="6">System articles are fully regenerated on each epic compilation (not incrementally updated)</criterion>
    <criterion id="7">Story-level compilation only updates dependency-map.md incrementally (adding new edges, not regenerating)</criterion>
  </acceptanceCriteria>

