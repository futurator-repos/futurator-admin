  <story>
    <asA>developer</asA>
    <iWant>superseded nodes with no active dependents automatically identified and archived</iWant>
    <soThat>the knowledge graph stays current and dead knowledge doesn't pollute search results</soThat>
    <tasks>
      <task id="1" ac="1">Implement pruning scan Cypher query
        <subtask>Create pruning-scan.mjs script at /home/ubuntu/scripts/pruning-scan.mjs</subtask>
        <subtask>Execute the pruning candidates Cypher query: find superseded nodes with no active DEPENDS_ON dependents</subtask>
        <subtask>Return candidate list as JSON with nodeId, title, type, lastUpdated, supersededBy</subtask>
        <subtask>Accept --project and --knowledge-dir flags</subtask>
      </task>
      <task id="2" ac="2">Implement confirmation mode
        <subtask>Default mode outputs candidate list to stdout as formatted table</subtask>
        <subtask>Accept --confirm flag or interactive prompt to proceed</subtask>
        <subtask>Allow selective pruning by passing specific --node-ids</subtask>
      </task>
      <task id="3" ac="3,8">Implement auto-prune mode
        <subtask>Accept --auto flag that skips confirmation and archives all candidates</subtask>
        <subtask>Auto mode is triggered by deployment compilation pipeline (Story 3.3)</subtask>
        <subtask>Validate that auto-prune is only called from deployment context</subtask>
      </task>
      <task id="4" ac="4">Implement article archival
        <subtask>Move markdown files from knowledge/{phase}/{slug}.md to knowledge/archive/{phase}--{slug}.md</subtask>
        <subtask>Preserve full article content (articles are recoverable)</subtask>
        <subtask>Update frontmatter: status: pruned, prunedAt: {date}, prunedReason</subtask>
        <subtask>Ensure knowledge/archive/ directory exists</subtask>
      </task>
      <task id="5" ac="5">Implement Memgraph node removal
        <subtask>For each pruned node: MATCH (n:Node {nodeId: $nodeId}) DETACH DELETE n</subtask>
        <subtask>DETACH DELETE removes the node and all its edges</subtask>
        <subtask>Verify deletion with follow-up existence check</subtask>
        <subtask>Log each deletion to stdout</subtask>
      </task>
      <task id="6" ac="6,7">Update index and log
        <subtask>Remove pruned articles from knowledge/index.md catalog entries</subtask>
        <subtask>Append pruning records to knowledge/log.md with format: [PRUNED] {date} | {nodeId} | Reason</subtask>
        <subtask>Update knowledge/system/pending-work.md to remove entries for pruned nodes</subtask>
      </task>
      <task id="7" ac="8">Integrate with deployment compilation pipeline
        <subtask>Deployment compilation (Story 3.3) calls pruning as part of prune-sync shell step</subtask>
        <subtask>Pruning runs AFTER deploy-nodes agent step (which marks code as deployed)</subtask>
        <subtask>Pruning runs BEFORE final graph-sync (so sync reflects pruned state)</subtask>
        <subtask>Add --auto flag when called from deployment pipeline context</subtask>
      </task>
    </tasks>
  </story>

