  <story>
    <asA>developer</asA>
    <iWant>Memgraph running as a Docker container on the existing EC2 instance with persistent storage and auto-restart</iWant>
    <soThat>I have a graph database with native vector index support available for the Mycelium knowledge graph</soThat>
    <tasks>
      <task id="1" ac="1">Install Docker and docker-compose on EC2
        <subtask>SSH into EC2 via SSM or connect via daemon</subtask>
        <subtask>Install Docker Engine for Ubuntu ARM64 (apt-get install docker-ce docker-ce-cli containerd.io)</subtask>
        <subtask>Install docker-compose plugin (apt-get install docker-compose-plugin)</subtask>
        <subtask>Add ubuntu user to docker group (usermod -aG docker ubuntu)</subtask>
        <subtask>Enable Docker service on boot (systemctl enable docker)</subtask>
        <subtask>Verify with docker --version and docker compose version</subtask>
      </task>
      <task id="2" ac="2,3,4,5,6,8">Create docker-compose.yml for Memgraph
        <subtask>Create /home/ubuntu/memgraph/docker-compose.yml</subtask>
        <subtask>Configure ports: 7687:7687 (Bolt), 7444:7444 (monitoring)</subtask>
        <subtask>Configure volume: memgraph-data:/var/lib/memgraph</subtask>
        <subtask>Set command flags: --memory-limit=512 --storage-parallel-schema-recovery=true --log-level=WARNING</subtask>
        <subtask>Set container resource limit: memory 600M</subtask>
        <subtask>Set restart policy: unless-stopped</subtask>
        <subtask>Use image memgraph/memgraph:latest (ARM64 support)</subtask>
      </task>
      <task id="3" ac="2,7">Start Memgraph and verify
        <subtask>Run docker compose up -d from /home/ubuntu/memgraph/</subtask>
        <subtask>Verify container running: docker ps | grep memgraph</subtask>
        <subtask>Check logs: docker logs futurator-memgraph</subtask>
        <subtask>Verify port 7687 listening: ss -tlnp | grep 7687</subtask>
      </task>
      <task id="4" ac="7">Create connection test script
        <subtask>Create /home/ubuntu/scripts/test-memgraph.mjs</subtask>
        <subtask>Install neo4j-driver package in scripts directory</subtask>
        <subtask>Script connects to bolt://localhost:7687, runs RETURN 1 AS test</subtask>
        <subtask>Script reports connection status, Memgraph version, memory usage</subtask>
        <subtask>Run test and confirm success</subtask>
      </task>
      <task id="5" ac="4,5">Verify persistence and restart behavior
        <subtask>Insert test node via Cypher: CREATE (n:Test {name: 'persistence-check'})</subtask>
        <subtask>Restart container: docker compose restart</subtask>
        <subtask>Query test node to confirm persistence</subtask>
        <subtask>Clean up test node</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">Docker and docker-compose are installed on EC2 instance i-0826d68c316ae97dd (Ubuntu 24.04 ARM64)</criterion>
    <criterion id="2">Memgraph container is running and accessible on port 7687 (Bolt protocol)</criterion>
    <criterion id="3">Memgraph is configured with --memory-limit=512 and --log-level=WARNING</criterion>
    <criterion id="4">Container restart policy is unless-stopped (survives EC2 reboots)</criterion>
    <criterion id="5">Data is persisted via Docker volume memgraph-data at /var/lib/memgraph</criterion>
