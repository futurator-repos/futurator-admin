      <name>Conflict detection Cypher</name>
      <kind>database query</kind>
      <signature>MATCH (d1:Node {type: 'adr', projectId: $projectId}), (d2:Node {type: 'adr', projectId: $projectId}) WHERE d1.nodeId != d2.nodeId AND any(tag IN d1.tags WHERE tag IN d2.tags) RETURN d1, d2, vector_similarity(d1.embedding, d2.embedding) AS sim WHERE sim > 0.8</signature>
      <path>/home/ubuntu/scripts/lib/extract-decisions.mjs</path>
    </interface>
    <interface>
      <name>Traceability chain Cypher</name>
      <kind>database query</kind>
      <signature>MATCH (req:Node {type: 'requirement'})-[:DERIVED_FROM]->(dec:Node {type: 'adr'})-[:INFORMS]->(code:Node {type: 'code'}) WHERE req.projectId = $projectId RETURN req.title, dec.title, code.title, code.status</signature>
      <path>/home/ubuntu/scripts/lib/extract-decisions.mjs</path>
    </interface>
