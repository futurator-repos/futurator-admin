  <story>
    <asA>developer</asA>
    <iWant>import/require statements automatically analyzed to create DEPENDS_ON edges between code articles</iWant>
    <soThat>the dependency graph accurately reflects the actual code structure</soThat>
    <tasks>
      <task id="1" ac="1,6,7">Implement import parser
        <subtask>Create /home/ubuntu/scripts/bootstrap-deps.mjs — dependency extraction orchestrator</subtask>
        <subtask>Implement TypeScript/JavaScript import parsing: import X from '...', import { X } from '...', import * as X from '...', require('...')</subtask>
        <subtask>Implement Python import parsing: import X, from X import Y</subtask>
        <subtask>Implement CSS/SCSS import parsing: @import '...', @use '...'</subtask>
        <subtask>Resolve relative paths (./, ../) to absolute file paths within the project</subtask>
        <subtask>Handle barrel exports — when an import points to a directory or index.ts, trace through to the actual re-exported modules</subtask>
        <subtask>Classify imports as internal (project files) vs. external (npm packages, stdlib)</subtask>
      </task>
      <task id="2" ac="2,3">Map imports to wiki article slugs
        <subtask>Convert resolved file paths to wiki article slugs: src/utils/jwt.ts to code/src--utils--jwt.ts</subtask>
        <subtask>Read the bootstrap manifest (.mycelium/bootstrap-manifest.json) to validate that target articles exist</subtask>
        <subtask>For each source file, build the complete list of internal dependencies and dependents</subtask>
        <subtask>Handle files not in the manifest (referenced but excluded from scan) — log as unresolved imports</subtask>
      </task>
      <task id="3" ac="3,7">Update wiki articles with dependency edges
        <subtask>For each code article in knowledge/code/, update the ## Dependencies section with outgoing [[wikilinks]] and import descriptions</subtask>
        <subtask>Update the ## Dependents section with incoming [[wikilinks]] (reverse edges)</subtask>
        <subtask>List external dependencies (npm packages) in a separate ## External Dependencies subsection without [[wikilinks]]</subtask>
        <subtask>Preserve existing article content (Purpose, Key Exports, Signals, etc.) — only modify Dependencies/Dependents sections</subtask>
      </task>
      <task id="4" ac="4,5">Generate dependency map and detect cycles
        <subtask>Build the full dependency adjacency list from all parsed imports</subtask>
        <subtask>Run cycle detection algorithm (DFS-based) on the adjacency list</subtask>
        <subtask>Generate knowledge/system/dependency-map.md with: summary statistics (total files, total edges, circular count), full dependency listing per file, circular dependency section with cycle paths</subtask>
        <subtask>Update knowledge/index.md to include the dependency-map article</subtask>
        <subtask>Append dependency extraction record to knowledge/log.md</subtask>
      </task>
      <task id="5" ac="1">Pipeline integration and progress tracking
        <subtask>Register as stage 2 of the brownfield-bootstrap pipeline (runs after scan stage completes)</subtask>
        <subtask>Emit pipeline events: { type: progress, stage: deps, filesProcessed: X, edgesCreated: Y }</subtask>
        <subtask>Log summary: total dependencies extracted, circular dependencies found, unresolved imports</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">Import/require/from statements are parsed from each source file in the project</criterion>
    <criterion id="2">Imports are mapped to their corresponding wiki article paths using the -- slug convention (e.g., import from '../utils/jwt' maps to [[code/src--utils--jwt.ts]])</criterion>
    <criterion id="3">DEPENDS_ON edges are created in wiki articles' Dependencies and Dependents sections via [[wikilinks]]</criterion>
    <criterion id="4">knowledge/system/dependency-map.md is generated with the full import graph (listing every file and its direct dependencies)</criterion>
    <criterion id="5">Circular dependencies are detected, logged, and noted in dependency-map.md with a dedicated section</criterion>
    <criterion id="6">Barrel exports (index.ts re-exports) are resolved — imports from a directory are traced to the actual source file</criterion>
    <criterion id="7">External dependencies (npm packages) are listed in articles but do not generate cross-article [[wikilinks]] (no wiki article exists for them)</criterion>
  </acceptanceCriteria>

