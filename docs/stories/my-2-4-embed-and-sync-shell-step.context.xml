  <story>
    <asA>developer</asA>
    <iWant>a shell step that embeds new/changed wiki articles and syncs them to Memgraph after compilation</iWant>
    <soThat>the GraphRAG index stays current with the latest compiled knowledge</soThat>
    <tasks>
      <task id="1" ac="1,2,3,4">Define the embed-sync shell step in the pipeline
        <subtask>Add the compile-sync shell step to generateStoryPipeline() after the compile-knowledge step</subtask>
        <subtask>Set the command to call node /home/ubuntu/scripts/graph-sync.mjs with --project, --knowledge-dir, and --state-file flags</subtask>
        <subtask>Template the command with {{projectId}} and {{workingDir}} variables</subtask>
        <subtask>Set appropriate timeout (e.g., 60000ms to account for Voyage AI API latency)</subtask>
      </task>
      <task id="2" ac="1,2,3,4">Integrate graph-sync.mjs invocation
        <subtask>Verify graph-sync.mjs from Story 1.5 is deployed to /home/ubuntu/scripts/ on EC2</subtask>
        <subtask>Verify the script reads compile-state.json, diffs content hashes, embeds changed articles, and upserts to Memgraph</subtask>
        <subtask>Verify the script updates compile-state.json with new hashes after sync</subtask>
        <subtask>Ensure the script outputs sync summary (articles processed, nodes upserted, edges created) to stdout for pipeline event capture</subtask>
      </task>
      <task id="3" ac="5">Integrate S3 backup step
        <subtask>Append aws s3 sync command to the shell step (or chain as a separate command after graph-sync)</subtask>
        <subtask>Configure S3 path as s3://futurator-ai-website/knowledge-live/{{projectId}}/</subtask>
        <subtask>Use --delete flag to remove articles that have been archived</subtask>
        <subtask>Ensure S3 backup errors are logged but do not fail the step (best-effort backup)</subtask>
      </task>
      <task id="4" ac="1,4">Handle edge cases and error recovery
        <subtask>Handle first-ever sync (empty compile-state.json) — should process all articles</subtask>
        <subtask>Handle Voyage AI API failures with retry logic (already built into lib/voyage-embed.mjs from Story 1.4)</subtask>
        <subtask>Handle Memgraph connection failures — log error, skip sync, preserve compile-state for next attempt</subtask>
        <subtask>Ensure partial sync does not corrupt compile-state.json (write atomically with temp file + rename)</subtask>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">All new/changed wiki articles are detected via content hash comparison against .mycelium/compile-state.json</criterion>
    <criterion id="2">Changed articles are embedded via Voyage AI (voyage-3-large, 1024-dim) and upserted into Memgraph as nodes with all frontmatter properties and embedding vectors</criterion>
    <criterion id="3">Edges from [[wikilinks]] in articles are created/updated in Memgraph using the typed edge model (DEPENDS_ON, DERIVED_FROM, INFORMS, etc.)</criterion>
    <criterion id="4">.mycelium/compile-state.json is updated with new content hashes after successful sync</criterion>
    <criterion id="5">The wiki directory is backed up to S3 at s3://futurator-ai-website/knowledge-live/{projectId}/ after sync</criterion>
  </acceptanceCriteria>

